	// HIGH-PERFORMANCE NATIVE SCROLL REVEAL ANIMATIONS (Compositor Thread Only!)
	@media (prefers-reduced-motion: no-preference) {
		@supports ((animation-timeline: view()) and (animation-range: entry)) {
			@keyframes reveal-up {
				from {
					opacity: 0;
					transform: translateY(60px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.grid-card, .coach-card, .about-stat-box, .studio-frame, .map-wrapper, .about-photo-frame {
				animation: reveal-up auto cubic-bezier(0.16, 1, 0.3, 1) backwards;
				animation-timeline: view();
				animation-range: entry 10% entry 70%;
			}
		}
