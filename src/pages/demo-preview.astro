	// WHY US / BRUTALIST GRID
	.why-us {
		padding: 120px 0;
		border-bottom: 1.5px solid rgba(139, 101, 64, 0.15);

		.container {
			max-width: 1200px;
			margin: 0 auto;
			padding: 0 24px;
		}
	}

	.section-header {
		max-width: 700px;
		margin-bottom: 64px;

		&.center {
			margin-left: auto;
			margin-right: auto;
			text-align: center;
		}

		.section-title {
			font-size: clamp(2rem, 4vw, 3rem);
			line-height: 1.1;
			margin-bottom: 16px;
		}

		.section-desc {
			font-size: 1.1rem;
			color: $color-taupe-beige;
			font-weight: 300;
		}
	}

	.brutalist-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5px;
		background-color: $color-bronze;
		border: 1.5px solid $color-bronze;
		box-shadow: 0 20px 40px rgba(0,0,0,0.3);

		.grid-card {
			background-color: $color-dark-charcoal;
			padding: 48px 36px;
			transition: background-color 0.3s ease;

			&:hover {
				background-color: #1e1b18;
